{
  "name": "Cosmisk API — UGC Projects List",
  "nodes": [
    {
      "parameters": {
        "path": "ugc/projects",
        "httpMethod": "GET",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [380, 300],
      "id": "api-proj-webhook",
      "name": "Webhook",
      "webhookId": "cosmisk-ugc-projects"
    },
    {
      "parameters": {
        "jsCode": "const authHeader = $input.first().json.headers?.authorization || '';\nif (!authHeader.startsWith('Bearer ')) {\n  return [{ json: { _unauthorized: true } }];\n}\nconst token = authHeader.replace('Bearer ', '');\ntry {\n  const decoded = JSON.parse(Buffer.from(token, 'base64').toString());\n  if (decoded.exp && Date.now() > decoded.exp) {\n    return [{ json: { _unauthorized: true } }];\n  }\n  return [{ json: { ...$input.first().json, _user: decoded } }];\n} catch(e) {\n  return [{ json: { _unauthorized: true } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300],
      "id": "api-proj-auth",
      "name": "Auth Check"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json._unauthorized ? 'unauthorized' : 'ok' }}",
        "rules": {
          "rules": [
            { "value2": "unauthorized", "output": 0 },
            { "value2": "ok", "output": 1 }
          ]
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [820, 300],
      "id": "api-proj-gate",
      "name": "Auth Gate"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Unauthorized' }) }}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 160],
      "id": "api-proj-respond-401",
      "name": "Respond 401"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appvFxwZc9yU8o8pK/Projects?pageSize=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 400],
      "id": "api-proj-fetch",
      "name": "Fetch Projects",
      "credentials": {
        "airtableTokenApi": {
          "id": "WelvlJEjoHaI3l9G",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst records = response.records || [];\n\nconst projects = records.map(r => ({\n  id: r.id,\n  client_code: r.fields.client_code || '',\n  brand_name: r.fields.brand_name || '',\n  status: r.fields.status || r.fields.Status || '',\n  num_scripts: r.fields.num_scripts || 0,\n  created_at: r.createdTime || '',\n  pm_email: r.fields.pm_email || ''\n}));\n\n// Sort by created_at descending\nprojects.sort((a, b) => b.created_at.localeCompare(a.created_at));\n\nreturn [{ json: { success: true, projects } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 400],
      "id": "api-proj-transform",
      "name": "Transform"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1500, 400],
      "id": "api-proj-respond-ok",
      "name": "Respond"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Auth Check", "type": "main", "index": 0 }
        ]
      ]
    },
    "Auth Check": {
      "main": [
        [
          { "node": "Auth Gate", "type": "main", "index": 0 }
        ]
      ]
    },
    "Auth Gate": {
      "main": [
        [
          { "node": "Respond 401", "type": "main", "index": 0 }
        ],
        [
          { "node": "Fetch Projects", "type": "main", "index": 0 }
        ]
      ]
    },
    "Fetch Projects": {
      "main": [
        [
          { "node": "Transform", "type": "main", "index": 0 }
        ]
      ]
    },
    "Transform": {
      "main": [
        [
          { "node": "Respond", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
