# =============================================================================
# Smashed Agency — UGC Script Engine Configuration
# =============================================================================
# Copy this file to config.env and fill in your values:
#   cp config.env.example config.env
#
# Then run the setup script:
#   bash setup.sh
# =============================================================================

# --- n8n Base URL ---
# Your n8n instance URL (no trailing slash)
# Examples: https://smashed.app.n8n.cloud  or  http://localhost:5678
N8N_BASE_URL=

# --- Credential IDs ---
# After creating each credential in n8n (Settings → Credentials), get the ID:
#   1. Open the credential
#   2. Copy the ID from the browser URL: /credentials/{THIS_IS_THE_ID}
#   Or use the n8n API: GET /api/v1/credentials

AIRTABLE_CREDENTIAL_ID=
OPENAI_CREDENTIAL_ID=
SERPAPI_CREDENTIAL_ID=
GOOGLE_SHEETS_CREDENTIAL_ID=
GOOGLE_DRIVE_CREDENTIAL_ID=
SLACK_CREDENTIAL_ID=
CLICKUP_CREDENTIAL_ID=

# --- Google Sheet ---
# Your Google Sheet ID (from the URL: docs.google.com/spreadsheets/d/{THIS_PART}/edit)
# Leave blank to keep the default placeholder
GOOGLE_SHEET_ID=

# --- Slack ---
# Slack channel ID for notifications (right-click channel → View channel details → scroll to bottom)
SLACK_CHANNEL_ID=
# PM's Slack user ID for error DMs
SLACK_PM_USER_ID=

# --- ClickUp (Optional) ---
# ClickUp Space ID and Workspace ID
CLICKUP_SPACE_ID=
CLICKUP_WORKSPACE_ID=

# --- Google Drive ---
# Parent folder ID for client folders
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=

# --- Airtable ---
# Leave blank to keep the pre-configured Base ID (appvFxwZc9yU8o8pK)
AIRTABLE_BASE_ID=
