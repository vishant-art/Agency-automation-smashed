    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/appvFxwZc9yU8o8pK/Projects/{{ $json.project_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 500],
      "id": "api-det-fetch-project",
      "name": "Fetch Project",
      "credentials": {
        "airtableTokenApi": {
          "id": "WelvlJEjoHaI3l9G",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const project = $input.first().json;\nconst clientCode = project.fields?.client_code || '';\n\n// Store project data and client_code for next nodes\nreturn [{ json: { project, client_code: clientCode } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1720, 500],
      "id": "api-det-extract-code",
      "name": "Extract Client Code"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/appvFxwZc9yU8o8pK/Concepts?filterByFormula=FIND('{{ $json.client_code }}',ARRAYJOIN({project_id}))>0&pageSize=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1940, 400],
      "id": "api-det-fetch-concepts",
      "name": "Fetch Concepts",
      "credentials": {
        "airtableTokenApi": {
          "id": "WelvlJEjoHaI3l9G",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/appvFxwZc9yU8o8pK/Scripts?filterByFormula=FIND('{{ $json.client_code }}',ARRAYJOIN({project_id}))>0&pageSize=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1940, 600],
      "id": "api-det-fetch-scripts",
      "name": "Fetch Scripts",
      "credentials": {
        "airtableTokenApi": {
          "id": "WelvlJEjoHaI3l9G",
          "name": "Airtable Personal Access Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gather data (sequential: Extract Client Code → Fetch Concepts → Fetch Scripts → here)\nconst projectData = $('Extract Client Code').first().json.project;\nconst conceptsData = $('Fetch Concepts').first().json;\nconst scriptsData = $input.first().json;\n\nconst conceptRecords = (conceptsData.records || []);\nconst scriptRecords = (scriptsData.records || []);\n\n// Transform project\nconst project = {\n  id: projectData.id,\n  client_code: projectData.fields?.client_code || '',\n  brand_name: projectData.fields?.brand_name || '',\n  status: projectData.fields?.status || projectData.fields?.Status || '',\n  num_scripts: projectData.fields?.num_scripts || 0,\n  created_at: projectData.fields?.created_at || projectData.createdTime || '',\n  pm_email: projectData.fields?.pm_email || '',\n  client_name: projectData.fields?.client_name || '',\n  client_email: projectData.fields?.client_email || '',\n  website_url: projectData.fields?.website_url || '',\n  brand_personality: projectData.fields?.brand_personality || '',\n  target_user: projectData.fields?.target_user || '',\n  target_audience: projectData.fields?.target_user || '',\n  product_feature: projectData.fields?.product_feature || '',\n  differentiator: projectData.fields?.differentiator || ''\n};\n\n// Transform concepts\nconst concepts = conceptRecords.map(c => ({\n  id: c.id,\n  concept_name: c.fields?.concept_name || c.fields?.name || '',\n  title: c.fields?.concept_name || c.fields?.name || '',\n  status: c.fields?.status || c.fields?.Status || '',\n  hook_type: c.fields?.hook_type || '',\n  angle: c.fields?.angle || '',\n  reference_url: c.fields?.reference_url || '',\n  created_at: c.fields?.created_at || c.createdTime || ''\n}));\n\n// Transform scripts\nconst scripts = scriptRecords.map(s => ({\n  id: s.id,\n  title: s.fields?.title || s.fields?.script_title || '',\n  status: s.fields?.status || s.fields?.Status || '',\n  overall_status: s.fields?.status || s.fields?.Status || '',\n  version: s.fields?.version || 1,\n  google_doc_id: s.fields?.google_doc_id || '',\n  google_doc_url: s.fields?.google_doc_url || '',\n  concept_id: s.fields?.concept_id || '',\n  created_at: s.fields?.created_at || s.createdTime || ''\n}));\n\nreturn [{\n  json: {\n    success: true,\n    project: {\n      ...project,\n      concepts,\n      scripts\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2160, 500],
      "id": "api-det-merge",
      "name": "Merge & Transform"
