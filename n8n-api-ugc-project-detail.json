{
  "name": "Cosmisk API — UGC Project Detail",
  "nodes": [
    {
      "parameters": {
        "path": "ugc/project-detail",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [380, 300],
      "id": "api-det-webhook",
      "name": "Webhook",
      "webhookId": "cosmisk-ugc-project-detail"
    },
    {
      "parameters": {
        "jsCode": "const authHeader = $input.first().json.headers?.authorization || '';\nif (!authHeader.startsWith('Bearer ')) {\n  return [{ json: { _unauthorized: true } }];\n}\nconst token = authHeader.replace('Bearer ', '');\ntry {\n  const decoded = JSON.parse(Buffer.from(token, 'base64').toString());\n  if (decoded.exp && Date.now() > decoded.exp) {\n    return [{ json: { _unauthorized: true } }];\n  }\n  return [{ json: { ...$input.first().json, _user: decoded } }];\n} catch(e) {\n  return [{ json: { _unauthorized: true } }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300],
      "id": "api-det-auth",
      "name": "Auth Check"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json._unauthorized ? 'unauthorized' : 'ok' }}",
        "rules": {
          "rules": [
            { "value2": "unauthorized", "output": 0 },
            { "value2": "ok", "output": 1 }
          ]
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [820, 300],
      "id": "api-det-gate",
      "name": "Auth Gate"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Unauthorized' }) }}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 160],
      "id": "api-det-respond-401",
      "name": "Respond 401"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst project_id = (body.project_id || '').trim();\n\nif (!project_id) {\n  return [{ json: { _error: true, message: 'project_id is required' } }];\n}\n\nreturn [{ json: { project_id, _user: $input.first().json._user } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 400],
      "id": "api-det-extract",
      "name": "Extract Project ID"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json._error ? 'error' : 'ok' }}",
        "rules": {
          "rules": [
            { "value2": "error", "output": 0 },
            { "value2": "ok", "output": 1 }
          ]
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [1280, 400],
      "id": "api-det-check-input",
      "name": "Check Input"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.message || 'Invalid input' }) }}",
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Access-Control-Allow-Origin", "value": "*" }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
