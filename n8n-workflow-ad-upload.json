  "name": "Ad Reference \u2014 Upload & Manage",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Ad Reference Upload\n\nPOST /upload-reference-ad\n```json\n{\n  \"ad_name\": \"Summer Sale UGC\",\n  \"brand_name\": \"Wheelwash\",\n  \"platform\": \"Meta\",\n  \"performance\": \"Top Performer\",\n  \"ad_url\": \"https://...\",\n  \"ad_copy\": \"Full ad script/copy\",\n  \"hook_text\": \"Opening hook line\",\n  \"format\": \"UGC\",\n  \"why_it_works\": \"Analysis\",\n  \"metrics\": \"CTR 3.2%, ROAS 4.5x\",\n  \"industry\": \"Automotive\",\n  \"project_id\": \"recXXX (optional)\",\n  \"notes\": \"Additional context\"\n}\n```\n\nStores in Reference_Ads table.\nPhase 3 auto-fetches matching ads.",
        "height": 420,
        "width": 450,
        "color": 5
      },
      "id": "ad-sticky",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "upload-reference-ad",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "ad-webhook",
      "name": "Webhook \u2014 Upload Ad",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        280,
        320
      ],
      "webhookId": "upload-reference-ad"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst required = ['ad_name', 'brand_name'];\nconst missing = required.filter(f => !body[f]);\nif (missing.length > 0) {\n  return [{ json: { error: true, message: 'Missing required fields: ' + missing.join(', ') } }];\n}\n\nreturn [{ json: {\n  error: false,\n  fields: {\n    ad_name: body.ad_name || '',\n    brand_name: body.brand_name || '',\n    platform: body.platform || '',\n    performance: body.performance || 'Average',\n    ad_url: body.ad_url || '',\n    ad_copy: body.ad_copy || '',\n    hook_text: body.hook_text || '',\n    format: body.format || '',\n    why_it_works: body.why_it_works || '',\n    metrics: body.metrics || '',\n    industry: body.industry || '',\n    project_id: body.project_id || '',\n    uploaded_by: body.uploaded_by || 'API',\n    notes: body.notes || ''\n  }\n} }];"
      },
      "id": "ad-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "check-err",
              "leftValue": "={{ $json.error }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ad-if-error",
      "name": "Has Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ status: 'error', message: $json.message }) }}",
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "ad-error-resp",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.airtable.com/v0/appvFxwZc9yU8o8pK/tbl6ePpaHIQvCqy8K",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: $json.fields }) }}",
        "options": {}
      },
      "id": "ad-store",
      "name": "Store in Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        460
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "WelvlJEjoHaI3l9G",
          "name": "Airtable Personal Access Token account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ JSON.stringify({ status: 'success', message: 'Reference ad stored', record_id: $json.id, ad_name: $json.fields?.ad_name || '' }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "ad-success-resp",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1500,
        460
      ]
    }
  ],
