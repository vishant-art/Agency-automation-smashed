{
  "name": "Migration — Hash Plaintext Passwords",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [380, 300],
      "id": "migration-trigger",
      "name": "Manual Trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appvFxwZc9yU8o8pK/tblP2TPWErU0s6M4w",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300],
      "id": "migration-fetch-users",
      "name": "Fetch All Users",
      "credentials": {
        "httpHeaderAuth": {
          "id": "a0TTu3NVsuJUEbct",
          "name": "Airtable PAT Header"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst records = $input.first().json.records || [];\nconst updates = [];\n\nfor (const rec of records) {\n  const pwd = rec.fields?.password || '';\n  const existingHash = rec.fields?.password_hash || '';\n\n  // Skip if already hashed (contains ':')\n  if (existingHash && existingHash.includes(':')) continue;\n\n  // Skip if no password at all\n  const toHash = pwd || existingHash;\n  if (!toHash) continue;\n\n  // Hash the plaintext password\n  const salt = crypto.randomBytes(16).toString('hex');\n  const hash = crypto.createHash('sha256').update(salt + toHash).digest('hex');\n\n  updates.push({\n    id: rec.id,\n    fields: {\n      password_hash: salt + ':' + hash,\n      password: ''\n    }\n  });\n}\n\nreturn [{ json: {\n  updates,\n  updateBody: JSON.stringify({ records: updates }),\n  count: updates.length\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 300],
      "id": "migration-hash",
      "name": "Hash Plaintext Passwords"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        },
        "options": {
          "typeValidation": "loose"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1060, 300],
      "id": "migration-has-updates",
      "name": "Has Updates?"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://api.airtable.com/v0/appvFxwZc9yU8o8pK/tblP2TPWErU0s6M4w",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.updateBody }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 200],
      "id": "migration-update-users",
      "name": "Update Users",
      "credentials": {
        "httpHeaderAuth": {
          "id": "a0TTu3NVsuJUEbct",
          "name": "Airtable PAT Header"
        }
      }
    }
  ],
  "connections": {
